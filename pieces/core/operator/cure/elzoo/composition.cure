# SPDX-License-Identifier: Apache-2.0
mod Elzoo.Composition
  use Std.Option

  rec Transition(s, o)
    state: s
    output: Option(o)

  rec Joined(s, t)
    left: s
    right: t

  # Generic sequential composition of stateful operators with zero/one output.
  fn compose(
    first: (s, i) -> Transition(s, m),
    second: (t, m) -> Transition(t, o),
    state: Joined(s, t),
    input: i
  ) -> Transition(Joined(s, t), o) =
    let left = first(state.left, input)
    match left.output
      None() -> Transition{state: Joined{left: left.state, right: state.right}, output: None()}
      Some(value) ->
        let right = second(state.right, value)
        Transition{state: Joined{left: left.state, right: right.state}, output: right.output}

  fn discard(state: s, input: i) -> Transition(s, i) =
    Transition{state: state, output: None()}

  fn output(result: Transition(s, o)) -> Option(o) = result.output
  fn state_right(state: Joined(s, t)) -> t = state.right
  fn right_after(result: Transition(Joined(s, t), o)) -> t = result.state.right

  # A dropped input has no output and does not advance downstream state.
  fn drop_has_no_output(state: Joined(s, t), input: i, next: (t, i) -> Transition(t, o)) -> Equivalent(Option(o), output(compose(discard, next, state, input)), None()) =
    reflexive(output(compose(discard, next, state, input)))

  fn drop_keeps_downstream(state: Joined(s, t), input: i, next: (t, i) -> Transition(t, o)) -> Equivalent(t, right_after(compose(discard, next, state, input)), state_right(state)) =
    reflexive(state_right(state))

end
