{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "schema_id", "schema_version", "request", "at_ms", "entries"],
  "properties": {
    "version": {"const": 1},
    "kind": {"const": "gate"},
    "schema_id": {"const": "elzoo.run-engine.gate-verdict"},
    "schema_version": {"const": 1},
    "request": {"type": "integer", "minimum": 1, "maximum": 256},
    "at_ms": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "entries": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["index", "verdict", "reason", "gate_id", "gate_version"],
        "properties": {
          "index": {"type": "integer", "minimum": 0, "maximum": 63},
          "verdict": {"enum": ["allow", "deny"]},
          "reason": {"type": ["string", "null"], "pattern": "^[a-z0-9_]{1,64}$"},
          "gate_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "gate_version": {"type": "integer", "minimum": 1, "maximum": 2147483647}
        },
        "if": {"properties": {"verdict": {"const": "allow"}}},
        "then": {"properties": {"reason": {"type": "null"}}},
        "else": {"properties": {"reason": {"type": "string"}}}
      }
    }
  }
}
