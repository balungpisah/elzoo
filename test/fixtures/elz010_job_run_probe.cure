# ELZ-010 Contract-proposal probe (not a Piece): job-Run lifecycle decision.
mod Elzoo.JobRunProbe
  use Std.Option
  use Elzoo.RetryPolicy

  type RunPhase = RunRequested | RunActive | RunWaiting | RunSucceeded | RunFailed | RunExhausted | RunExpired | RunCancelled
  type RunInput = StartAttempt | StartDuplicate | StartStale | CurrentCompleted | CurrentFailed | StaleCompleted | StaleFailed | CancelRequested
  type RunAction = BeginAttempt | RecordSuccess | ScheduleRetry | RecordFailure | RecordExhausted | RecordExpired | RecordCancel | YieldDuplicate | YieldStale | NoChange

  rec RunStep
    phase: RunPhase
    action: RunAction

  fn start_input(bound_job: Int, job: Int, recorded_oban_attempt: Int, job_attempt: Int) -> RunInput =
    pickup
      bound_job == 0 -> StartAttempt()
      bound_job != job -> StartDuplicate()
      job_attempt >= recorded_oban_attempt -> StartAttempt()
      else -> StartStale()

  @total true
  @reducible
  fn current(completed: Bool) -> RunInput =
    match completed
      True() -> CurrentCompleted()
      False() -> CurrentFailed()

  @total true
  @reducible
  fn stale(completed: Bool) -> RunInput =
    match completed
      True() -> StaleCompleted()
      False() -> StaleFailed()

  fn result_input(completed: Bool, attempt: Int, last_attempt: Int) -> RunInput =
    pickup
      last_attempt == 0 -> stale(completed)
      attempt == last_attempt -> current(completed)
      else -> stale(completed)

  @total true
  @reducible
  fn keep(phase: RunPhase) -> RunStep = RunStep{phase: phase, action: NoChange()}

  @total true
  @reducible
  fn yield_to(phase: RunPhase) -> RunStep = RunStep{phase: phase, action: YieldDuplicate()}

  @total true
  @reducible
  fn stale_start(phase: RunPhase) -> RunStep = RunStep{phase: phase, action: YieldStale()}

  @total true
  @reducible
  fn expire() -> RunStep = RunStep{phase: RunExpired(), action: RecordExpired()}

  @total true
  @reducible
  fn cancel() -> RunStep = RunStep{phase: RunCancelled(), action: RecordCancel()}

  @total true
  @reducible
  fn begin() -> RunStep = RunStep{phase: RunActive(), action: BeginAttempt()}

  @total true
  @reducible
  fn idle(phase: RunPhase, input: RunInput, expired: Bool) -> RunStep =
    match input
      CancelRequested() -> cancel()
      StartAttempt() ->
        match expired
          True() -> expire()
          False() -> begin()
      StartDuplicate() -> yield_to(phase)
      StartStale() -> stale_start(phase)
      CurrentCompleted() -> keep(phase)
      CurrentFailed() -> keep(phase)
      StaleCompleted() -> keep(phase)
      StaleFailed() -> keep(phase)

  @total true
  @reducible
  fn after_failure(retry: RetryDecision) -> RunStep =
    match retry
      DecideRetry() -> RunStep{phase: RunWaiting(), action: ScheduleRetry()}
      DecideExhausted() -> RunStep{phase: RunExhausted(), action: RecordExhausted()}
      DecidePermanent() -> RunStep{phase: RunFailed(), action: RecordFailure()}
      DecideSettle() -> RunStep{phase: RunFailed(), action: RecordFailure()}
      DecideUnresolved() -> RunStep{phase: RunFailed(), action: RecordFailure()}

  @total true
  @reducible
  fn restart(retry: RetryDecision) -> RunStep =
    match retry
      DecideRetry() -> begin()
      DecideExhausted() -> RunStep{phase: RunExhausted(), action: RecordExhausted()}
      DecidePermanent() -> keep(RunActive())
      DecideSettle() -> keep(RunActive())
      DecideUnresolved() -> keep(RunActive())

  @total true
  @reducible
  fn active(input: RunInput, expired: Bool, retry: RetryDecision) -> RunStep =
    match input
      CancelRequested() -> cancel()
      CurrentCompleted() ->
        match expired
          True() -> expire()
          False() -> RunStep{phase: RunSucceeded(), action: RecordSuccess()}
      CurrentFailed() ->
        match expired
          True() -> expire()
          False() -> after_failure(retry)
      StaleCompleted() -> keep(RunActive())
      StaleFailed() -> keep(RunActive())
      StartDuplicate() -> yield_to(RunActive())
      StartStale() -> stale_start(RunActive())
      StartAttempt() ->
        match expired
          True() -> expire()
          False() -> restart(retry)

  @total true
  @reducible
  fn step(phase: RunPhase, input: RunInput, expired: Bool, retry: RetryDecision) -> RunStep =
    match phase
      RunRequested() -> idle(RunRequested(), input, expired)
      RunWaiting() -> idle(RunWaiting(), input, expired)
      RunActive() -> active(input, expired, retry)
      RunSucceeded() -> keep(RunSucceeded())
      RunFailed() -> keep(RunFailed())
      RunExhausted() -> keep(RunExhausted())
      RunExpired() -> keep(RunExpired())
      RunCancelled() -> keep(RunCancelled())

  @total true
  @reducible
  fn phase_of(s: RunStep) -> RunPhase = s.phase

  @total true
  @reducible
  fn action_of(s: RunStep) -> RunAction = s.action

  fn succeeded_absorbing(input: RunInput, expired: Bool, retry: RetryDecision) -> Equivalent(RunStep, step(RunSucceeded(), input, expired, retry), keep(RunSucceeded())) =
    reflexive(keep(RunSucceeded()))

  fn failed_absorbing(input: RunInput, expired: Bool, retry: RetryDecision) -> Equivalent(RunStep, step(RunFailed(), input, expired, retry), keep(RunFailed())) =
    reflexive(keep(RunFailed()))

  fn exhausted_absorbing(input: RunInput, expired: Bool, retry: RetryDecision) -> Equivalent(RunStep, step(RunExhausted(), input, expired, retry), keep(RunExhausted())) =
    reflexive(keep(RunExhausted()))

  fn expired_absorbing(input: RunInput, expired: Bool, retry: RetryDecision) -> Equivalent(RunStep, step(RunExpired(), input, expired, retry), keep(RunExpired())) =
    reflexive(keep(RunExpired()))

  fn cancelled_absorbing(input: RunInput, expired: Bool, retry: RetryDecision) -> Equivalent(RunStep, step(RunCancelled(), input, expired, retry), keep(RunCancelled())) =
    reflexive(keep(RunCancelled()))

  fn stale_completed_ignored_requested(expired: Bool, retry: RetryDecision) -> Equivalent(RunStep, step(RunRequested(), StaleCompleted(), expired, retry), keep(RunRequested())) =
    reflexive(keep(RunRequested()))

  fn stale_completed_ignored_waiting(expired: Bool, retry: RetryDecision) -> Equivalent(RunStep, step(RunWaiting(), StaleCompleted(), expired, retry), keep(RunWaiting())) =
    reflexive(keep(RunWaiting()))

  fn stale_completed_ignored_active(expired: Bool, retry: RetryDecision) -> Equivalent(RunStep, step(RunActive(), StaleCompleted(), expired, retry), keep(RunActive())) =
    reflexive(keep(RunActive()))

  fn stale_failed_ignored_requested(expired: Bool, retry: RetryDecision) -> Equivalent(RunStep, step(RunRequested(), StaleFailed(), expired, retry), keep(RunRequested())) =
    reflexive(keep(RunRequested()))

  fn stale_failed_ignored_waiting(expired: Bool, retry: RetryDecision) -> Equivalent(RunStep, step(RunWaiting(), StaleFailed(), expired, retry), keep(RunWaiting())) =
    reflexive(keep(RunWaiting()))

  fn stale_failed_ignored_active(expired: Bool, retry: RetryDecision) -> Equivalent(RunStep, step(RunActive(), StaleFailed(), expired, retry), keep(RunActive())) =
    reflexive(keep(RunActive()))

  fn duplicate_yields_requested(expired: Bool, retry: RetryDecision) -> Equivalent(RunStep, step(RunRequested(), StartDuplicate(), expired, retry), yield_to(RunRequested())) =
    reflexive(yield_to(RunRequested()))

  fn duplicate_yields_waiting(expired: Bool, retry: RetryDecision) -> Equivalent(RunStep, step(RunWaiting(), StartDuplicate(), expired, retry), yield_to(RunWaiting())) =
    reflexive(yield_to(RunWaiting()))

  fn duplicate_yields_active(expired: Bool, retry: RetryDecision) -> Equivalent(RunStep, step(RunActive(), StartDuplicate(), expired, retry), yield_to(RunActive())) =
    reflexive(yield_to(RunActive()))

  fn stale_start_never_begins_requested(expired: Bool, retry: RetryDecision) -> Equivalent(RunStep, step(RunRequested(), StartStale(), expired, retry), stale_start(RunRequested())) =
    reflexive(stale_start(RunRequested()))

  fn stale_start_never_begins_waiting(expired: Bool, retry: RetryDecision) -> Equivalent(RunStep, step(RunWaiting(), StartStale(), expired, retry), stale_start(RunWaiting())) =
    reflexive(stale_start(RunWaiting()))

  fn stale_start_never_begins_active(expired: Bool, retry: RetryDecision) -> Equivalent(RunStep, step(RunActive(), StartStale(), expired, retry), stale_start(RunActive())) =
    reflexive(stale_start(RunActive()))

  fn requested_completed_ignored(expired: Bool, retry: RetryDecision) -> Equivalent(RunStep, step(RunRequested(), CurrentCompleted(), expired, retry), keep(RunRequested())) =
    reflexive(keep(RunRequested()))

  fn requested_failed_ignored(expired: Bool, retry: RetryDecision) -> Equivalent(RunStep, step(RunRequested(), CurrentFailed(), expired, retry), keep(RunRequested())) =
    reflexive(keep(RunRequested()))

  fn waiting_completed_ignored(expired: Bool, retry: RetryDecision) -> Equivalent(RunStep, step(RunWaiting(), CurrentCompleted(), expired, retry), keep(RunWaiting())) =
    reflexive(keep(RunWaiting()))

  fn cancel_from_requested(expired: Bool, retry: RetryDecision) -> Equivalent(RunStep, step(RunRequested(), CancelRequested(), expired, retry), cancel()) =
    reflexive(cancel())

  fn cancel_from_waiting(expired: Bool, retry: RetryDecision) -> Equivalent(RunStep, step(RunWaiting(), CancelRequested(), expired, retry), cancel()) =
    reflexive(cancel())

  fn cancel_from_active(expired: Bool, retry: RetryDecision) -> Equivalent(RunStep, step(RunActive(), CancelRequested(), expired, retry), cancel()) =
    reflexive(cancel())

  fn expired_never_begins_requested(retry: RetryDecision) -> Equivalent(RunStep, step(RunRequested(), StartAttempt(), True(), retry), expire()) =
    reflexive(expire())

  fn expired_never_begins_waiting(retry: RetryDecision) -> Equivalent(RunStep, step(RunWaiting(), StartAttempt(), True(), retry), expire()) =
    reflexive(expire())

  fn expired_never_begins_active(retry: RetryDecision) -> Equivalent(RunStep, step(RunActive(), StartAttempt(), True(), retry), expire()) =
    reflexive(expire())

  fn exhausted_never_begins() -> Equivalent(RunPhase, phase_of(step(RunActive(), StartAttempt(), False(), DecideExhausted())), RunExhausted()) =
    reflexive(RunExhausted())

  fn late_success_expires(retry: RetryDecision) -> Equivalent(RunStep, step(RunActive(), CurrentCompleted(), True(), retry), expire()) =
    reflexive(expire())

  fn permanent_not_retried() -> Equivalent(RunPhase, phase_of(step(RunActive(), CurrentFailed(), False(), DecidePermanent())), RunFailed()) =
    reflexive(RunFailed())
end
