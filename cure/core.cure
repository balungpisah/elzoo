mod Elzoo.Core
  use Std.Option

  rec Message
    sender: Int
    incarnation: Int
    sequence: Int
    value: Int

  rec Transition(s, o)
    state: s
    output: Option(o)

  rec Joined(s, t)
    left: s
    right: t

  # Generic sequential composition of stateful operators with zero/one output.
  fn compose(
    first: (s, i) -> Transition(s, m),
    second: (t, m) -> Transition(t, o),
    state: Joined(s, t),
    input: i
  ) -> Transition(Joined(s, t), o) =
    let left = first(state.left, input)
    match left.output
      None() -> Transition{state: Joined{left: left.state, right: state.right}, output: None()}
      Some(value) ->
        let right = second(state.right, value)
        Transition{state: Joined{left: left.state, right: right.state}, output: right.output}

  fn discard(state: s, input: i) -> Transition(s, i) =
    Transition{state: state, output: None()}

  fn output(result: Transition(s, o)) -> Option(o) = result.output
  fn state_right(state: Joined(s, t)) -> t = state.right
  fn right_after(result: Transition(Joined(s, t), o)) -> t = result.state.right

  # A dropped input has no output and does not advance downstream state.
  fn drop_has_no_output(state: Joined(s, t), input: i, next: (t, i) -> Transition(t, o)) -> Equivalent(Option(o), output(compose(discard, next, state, input)), None()) =
    reflexive(output(compose(discard, next, state, input)))

  fn drop_keeps_downstream(state: Joined(s, t), input: i, next: (t, i) -> Transition(t, o)) -> Equivalent(t, right_after(compose(discard, next, state, input)), state_right(state)) =
    reflexive(state_right(state))

  # Exact key history is deliberately unbounded; this is not Zoo's windowed receiver.
  fn same_key(left: Message, right: Message) -> Bool =
    left.sender == right.sender and left.incarnation == right.incarnation and left.sequence == right.sequence

  fn seen(history: List(Message), input: Message) -> Bool =
    match history
      [] -> false
      [head | tail] ->
        pickup
          same_key(head, input) -> true
          else -> seen(tail, input)

  @total true
  fn emit(duplicate: Bool, input: Message) -> Option(Message) =
    match duplicate
      True() -> None()
      False() -> Some(input)

  fn receiver(state: List(Message), input: Message) -> Transition(List(Message), Message) =
    let duplicate = seen(state, input)
    let next = match duplicate
      true -> state
      false -> [input | state]
    Transition{state: next, output: emit(duplicate, input)}

  fn accumulate(total: Int, input: Message) -> Transition(Int, Int) =
    let next = total + input.value
    Transition{state: next, output: Some(next)}

  fn empty() -> Joined(List(Message), Int) = Joined{left: [], right: 0}

  fn assembly(state: Joined(List(Message), Int), input: Message) -> Transition(Joined(List(Message), Int), Int) =
    compose(receiver, accumulate, state, input)

  fn threshold(limit: Int, total: Int) -> Transition(Int, Bool) =
    Transition{state: limit, output: Some(total >= limit)}

  # An assembly is itself an operator behind the same interface.
  fn nested_empty(limit: Int) -> Joined(Joined(List(Message), Int), Int) =
    Joined{left: empty(), right: limit}

  fn nested(state: Joined(Joined(List(Message), Int), Int), input: Message) -> Transition(Joined(Joined(List(Message), Int), Int), Bool) =
    compose(assembly, threshold, state, input)

  fn message(sender: Int, incarnation: Int, sequence: Int, value: Int) -> Message =
    Message{sender: sender, incarnation: incarnation, sequence: sequence, value: value}

  # Selected general properties of the actual output decision.
  fn duplicate_emits_nothing(input: Message) -> Equivalent(Option(Message), emit(True(), input), None()) =
    reflexive(emit(True(), input))

  fn fresh_preserves_message(input: Message) -> Equivalent(Option(Message), emit(False(), input), Some(input)) =
    reflexive(Some(input))
end
