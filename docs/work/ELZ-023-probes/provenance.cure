              Rearm() -> no_origin()
              Expired() -> no_origin()
              SchemaInvalid() -> no_origin()
              CapacityRefused() -> no_origin()
              Uncertain() -> no_origin()
              Recover() -> no_origin()
          Intended(Fresh(), n) ->
            match event
              Admit() -> no_origin()
              Arm() ->
                match arm
                  True() -> Some(Fresh())
                  False() -> no_origin()
              NoSend() -> no_origin()
              PermanentNoSend() -> no_origin()
              Lost() -> no_origin()
              TimedOut() -> no_origin()
              Failed() -> no_origin()
