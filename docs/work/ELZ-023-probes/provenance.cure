              Recover() -> no_origin()
          Intended(After(g), n) ->
            match event
              Admit() -> no_origin()
              Arm() ->
                match arm
                  True() -> Some(After(g))
                  False() -> no_origin()
              NoSend() -> no_origin()
              PermanentNoSend() -> no_origin()
              Lost() -> no_origin()
              TimedOut() -> no_origin()
              Failed() -> no_origin()
              Pending() -> no_origin()
              NoEffect() -> no_origin()
              ProviderUnknown() -> no_origin()
              Completed() -> no_origin()
              Resume() -> no_origin()
              Rearm() -> no_origin()
              Expired() -> no_origin()
              SchemaInvalid() -> no_origin()
              CapacityRefused() -> no_origin()
              Uncertain() -> no_origin()
              Recover() -> no_origin()
