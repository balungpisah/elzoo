  @total true
  @reducible
  fn expect_definite_label(phase: Phase, disarmed: Bool, quarantined: Bool, event: Event, arm: Bool, rearm: Bool, replay: Bool, expired: Bool) -> Option(Ground) =
    match quarantined
      True() ->
        match phase
          Empty() -> no_ground()
          Intended(Fresh(), n) -> no_ground()
          Intended(After(g), n) -> no_ground()
          Dispatched(origin, n) -> no_ground()
          Definite(g, n) -> Some(g)
          Confirmed(n) -> no_ground()
          Stranded(n) -> no_ground()
      False() ->
        match phase
          Empty() ->
            match event
              Admit() -> no_ground()
              Arm() -> no_ground()
              NoSend() -> no_ground()
              PermanentNoSend() -> no_ground()
              Lost() -> no_ground()
              TimedOut() -> no_ground()
              Failed() -> no_ground()
              Pending() -> no_ground()
              NoEffect() -> no_ground()
              ProviderUnknown() -> no_ground()
              Completed() -> no_ground()
              Resume() -> no_ground()
              Rearm() -> no_ground()
              Expired() -> no_ground()
              SchemaInvalid() -> no_ground()
              CapacityRefused() -> no_ground()
              Uncertain() -> no_ground()
              Recover() -> no_ground()
          Intended(Fresh(), n) ->
            match event
              Admit() -> no_ground()
              Arm() ->
                match arm
                  True() -> no_ground()
                  False() -> no_ground()
              NoSend() -> no_ground()
              PermanentNoSend() -> no_ground()
              Lost() -> no_ground()
              TimedOut() -> no_ground()
              Failed() -> no_ground()
              Pending() -> no_ground()
              NoEffect() -> no_ground()
              ProviderUnknown() -> no_ground()
              Completed() -> no_ground()
              Resume() -> no_ground()
              Rearm() -> no_ground()
              Expired() -> no_ground()
              SchemaInvalid() -> no_ground()
              CapacityRefused() -> no_ground()
              Uncertain() -> no_ground()
              Recover() -> no_ground()
          Intended(After(g), n) ->
            match event
              Admit() -> no_ground()
              Arm() ->
                match arm
                  True() -> no_ground()
                  False() -> no_ground()
              NoSend() -> no_ground()
              PermanentNoSend() -> no_ground()
              Lost() -> no_ground()
              TimedOut() -> no_ground()
              Failed() -> no_ground()
              Pending() -> no_ground()
              NoEffect() -> no_ground()
              ProviderUnknown() -> no_ground()
              Completed() -> no_ground()
              Resume() -> no_ground()
              Rearm() -> no_ground()
              Expired() -> no_ground()
              SchemaInvalid() -> no_ground()
              CapacityRefused() -> no_ground()
              Uncertain() -> no_ground()
              Recover() -> no_ground()
          Dispatched(origin, n) ->
            match event
              Admit() -> no_ground()
              Arm() -> no_ground()
              NoSend() -> Some(AdapterNoSend())
              PermanentNoSend() -> Some(AdapterNoSend())
              Lost() -> no_ground()
              TimedOut() -> no_ground()
              Failed() -> no_ground()
              Pending() -> no_ground()
              NoEffect() -> Some(ProviderNoEffect())
              ProviderUnknown() ->
                match replay
                  True() -> Some(ProviderReplaySafe())
                  False() -> no_ground()
              Completed() -> no_ground()
              Resume() -> no_ground()
              Rearm() -> no_ground()
              Expired() ->
                match expired
                  True() -> no_ground()
                  False() -> no_ground()
              SchemaInvalid() -> no_ground()
              CapacityRefused() -> no_ground()
              Uncertain() -> no_ground()
              Recover() -> no_ground()
          Definite(g, n) ->
            match event
              Admit() -> Some(g)
              Arm() -> Some(g)
              NoSend() -> Some(g)
              PermanentNoSend() -> Some(g)
              Lost() -> Some(g)
              TimedOut() -> Some(g)
              Failed() -> Some(g)
              Pending() -> Some(g)
              NoEffect() -> Some(g)
              ProviderUnknown() -> Some(g)
              Completed() -> Some(g)
              Resume() -> Some(g)
              Rearm() ->
                match rearm
                  True() -> no_ground()
                  False() -> Some(g)
              Expired() -> Some(g)
              SchemaInvalid() -> Some(g)
              CapacityRefused() -> Some(g)
              Uncertain() -> Some(g)
              Recover() -> Some(g)
          Confirmed(n) ->
            match event
              Admit() -> no_ground()
              Arm() -> no_ground()
              NoSend() -> no_ground()
              PermanentNoSend() -> no_ground()
              Lost() -> no_ground()
              TimedOut() -> no_ground()
              Failed() -> no_ground()
              Pending() -> no_ground()
              NoEffect() -> no_ground()
              ProviderUnknown() -> no_ground()
              Completed() -> no_ground()
              Resume() -> no_ground()
              Rearm() -> no_ground()
              Expired() -> no_ground()
              SchemaInvalid() -> no_ground()
              CapacityRefused() -> no_ground()
              Uncertain() -> no_ground()
              Recover() -> no_ground()
          Stranded(n) ->
            match event
              Admit() -> no_ground()
              Arm() -> no_ground()
              NoSend() -> no_ground()
              PermanentNoSend() -> no_ground()
              Lost() -> no_ground()
              TimedOut() -> no_ground()
              Failed() -> no_ground()
              Pending() -> no_ground()
              NoEffect() -> no_ground()
              ProviderUnknown() -> no_ground()
              Completed() -> no_ground()
              Resume() -> no_ground()
              Rearm() -> no_ground()
              Expired() -> no_ground()
              SchemaInvalid() -> no_ground()
              CapacityRefused() -> no_ground()
              Uncertain() -> no_ground()
              Recover() -> no_ground()

  @total true
  @reducible
  fn expect_dispatch_origin(phase: Phase, disarmed: Bool, quarantined: Bool, event: Event, arm: Bool, rearm: Bool, replay: Bool, expired: Bool) -> Option(Origin) =
    match quarantined
      True() ->
        match phase
          Empty() -> no_origin()
          Intended(Fresh(), n) -> no_origin()
          Intended(After(g), n) -> no_origin()
          Dispatched(origin, n) -> no_origin()
          Definite(g, n) -> no_origin()
          Confirmed(n) -> no_origin()
          Stranded(n) -> no_origin()
      False() ->
        match phase
          Empty() ->
            match event
              Admit() -> no_origin()
              Arm() -> no_origin()
              NoSend() -> no_origin()
              PermanentNoSend() -> no_origin()
              Lost() -> no_origin()
              TimedOut() -> no_origin()
              Failed() -> no_origin()
              Pending() -> no_origin()
